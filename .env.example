# Copy to .env and fill. .env is git-ignored.

# --- identity: same EVM address on both chains (spec requirement) ---
PRIVATE_KEY=0x

# --- relayer: CC3 only. Proves permissionless relay (G0-A Q4).
#     Must be unrelated to PRIVATE_KEY. Needs CTC, no Sepolia ETH.
RELAYER_PRIVATE_KEY=0x

# --- Ethereum Sepolia = Attestcoin chainKey 1 ---
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111
CHAINKEY_SEPOLIA=1

# --- Creditcoin CC3 testnet ---
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CC3_WSS_URL=wss://rpc.cc3-testnet.creditcoin.network
CC3_CHAIN_ID=102031
CC3_EXPLORER=https://creditcoin-testnet.blockscout.com
VERIFY_PRECOMPILE=0x0000000000000000000000000000000000000FD2

# --- Attestcoin prover service ---
PROVER_API_URL=https://prover.cc3-testnet.creditcoin.network
PROVER_API_URL_ALT=https://proof-gen-api.cc3-testnet.creditcoin.network

# --- filled in during G0-A ---
SPIKE_SOURCE_ADDRESS=
SPIKE_ASC_ADDRESS=
